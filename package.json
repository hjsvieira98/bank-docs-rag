{
  "name": "fathom",
  "private": true,
  "version": "0.1.0",
  "description": "Cited answers over fictional Northline Bank documents. A TypeScript RAG project by Humberto Vieira.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev -w @fathom/api\" \"npm run dev -w @fathom/web\"",
    "start": "npm run start -w @fathom/api",
    "ingest": "tsx scripts/ingest.ts",
    "generate:pdf": "tsx scripts/generate-sample-pdf.ts",
    "eval": "tsx evals/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build -w @fathom/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
