# Fathom runs offline by default. No API key is required.
PORT=8787

# Embeddings: local | openai
# Anthropic does not offer an embeddings API. Chat and embeddings are chosen separately.
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536

# Answers: extractive | openai | anthropic
LLM_PROVIDER=extractive
# OPENAI_CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# RETRIEVAL_TOP_K=5
# RETRIEVAL_MIN_SCORE=0.12
# INDEX_DIR=data/index
# CORPUS_DIR=corpus
